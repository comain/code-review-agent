PYTHONUNBUFFERED=1
PIP_NO_INPUT=1

CR_AGENT_HOST=0.0.0.0
CR_AGENT_PORT=8000

CR_AGENT_BASE_DIR=runtime
CR_AGENT_REPO_CACHE_DIR=runtime/repos
CR_AGENT_TASK_DIR=runtime/tasks
CR_AGENT_REPORT_DIR=runtime/reports
CR_AGENT_LOG_DIR=logs

CR_AGENT_REPORT_PUBLIC_ROOT=/reports
CR_AGENT_OPENCODE_BIN=opencode
CR_AGENT_OPENCODE_COMMAND_TEMPLATE='cat {prompt_file} | {opencode_bin} run --dir {repo_path} --format json -m llm-proxy/gpt-5.5'
CR_AGENT_CI_ACK_URL=http://127.0.0.1/ci/plugin/ack

CR_AGENT_WORKER_THREADS=4
CR_AGENT_QUEUE_SIZE=128
CR_AGENT_TASK_TIMEOUT_SECONDS=1200
CR_AGENT_CALLBACK_TIMEOUT_SECONDS=10
CR_AGENT_CALLBACK_RETRY_TIMES=3
CR_AGENT_TRIGGER_TOKEN=
CR_AGENT_LLM_RETRY_TIMES=2
CR_AGENT_LLM_FORMAT_RETRY_TIMES=2
CR_AGENT_MAX_TASK_ATTEMPTS=3
CR_AGENT_FIX_WORKER_THREADS=2
CR_AGENT_ORPHAN_TASK_TIMEOUT_SECONDS=1800
CR_AGENT_RECOVERY_SCAN_INTERVAL_SECONDS=30
CR_AGENT_REVIEW_BASE_REFS=origin/master
CR_AGENT_REVIEW_V2_ENABLED=false
CR_AGENT_REVIEW_V2_DB_PATH=runtime/review_v2.sqlite3
CR_AGENT_REVIEW_V2_AUDIT_DIR=runtime/review_v2_audit
CR_AGENT_REVIEW_V2_DAEMON_POLL_INTERVAL_SECONDS=2
CR_AGENT_REVIEW_V2_DAEMON_CLAIM_LIMIT=1
CR_AGENT_REVIEW_V2_DAEMON_LEASE_SECONDS=300
CR_AGENT_REVIEW_V2_REVIEWER_CONCURRENCY=3
CR_AGENT_REVIEW_V2_GLOBAL_OPENCODE_CONCURRENCY=4
CR_AGENT_REVIEW_V2_LLM_PROXY_BASE_URL=http://openai-compatible.example.com/v1
CR_AGENT_REVIEW_V2_OPENCODE_PROVIDER_CHAIN=llm-proxy:gpt-5.5
